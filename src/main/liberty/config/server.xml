<?xml version="1.0" encoding="UTF-8"?>
<server description="Jakarta EE Pet Store">

    <featureManager>
        <!-- Web Profile covers CDI, JAX-RS, JSF, Bean Validation, Servlet, JPA, JSON-B/P -->
        <feature>webProfile-11.0</feature>
        <!-- Local EJB singletons for @Startup seed bean -->
        <feature>enterpriseBeansLite-4.0</feature>
        <!-- JDBC for the datasource -->
        <feature>jdbc-4.2</feature>
        <!-- JNDI for datasource lookup -->
        <feature>jndi-1.0</feature>
        <!-- Dev-mode hot reload -->
        <feature>localConnector-1.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="9443"/>

    <!-- Derby JARs are copied to this directory by maven-dependency-plugin on every build -->
    <library id="derbyLib">
        <fileset dir="${server.config.dir}/resources/derby" includes="*.jar"/>
    </library>

    <dataSource id="petStoreDS" jndiName="jdbc/petstore">
        <jdbcDriver libraryRef="derbyLib"/>
        <properties.derby.embedded databaseName="${server.output.dir}/data/petstore"
                                   createDatabase="create"/>
    </dataSource>

    <webApplication location="pet-store.war" contextRoot="/"/>

</server>
