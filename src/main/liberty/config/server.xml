<?xml version="1.0" encoding="UTF-8"?>
<server description="Jakarta EE Duck Clinic">

    <featureManager>
        <!-- Web Profile covers CDI, JAX-RS, JSF, Bean Validation, Servlet, JPA, JSON-B/P -->
        <feature>webProfile-11.0</feature>
        <!-- JNDI still needed for other lookups -->
        <feature>jndi-1.0</feature>
        <!-- Dev-mode hot reload -->
        <feature>localConnector-1.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="9443"/>

    <!-- No server-managed datasource: DuckDB uses RESOURCE_LOCAL JPA with the
         JDBC URL configured directly in persistence.xml -->

    <webApplication location="duck-clinic.war" contextRoot="/"/>

</server>
